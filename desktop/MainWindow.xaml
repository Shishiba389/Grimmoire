<Window x:Class="Grimoire.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="GRIMOIRE"
        Width="1440" Height="900"
        MinWidth="780" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="#0c0e14"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.TaskbarItemInfo>
        <TaskbarItemInfo Description="GRIMOIRE - Product Data Toolkit" />
    </Window.TaskbarItemInfo>

    <Grid>
        <!-- Splash / loading screen -->
        <Grid x:Name="SplashGrid" Panel.ZIndex="10">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0c0e14" Offset="0" />
                    <GradientStop Color="#12151e" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <!-- Logo -->
                <Border Width="72" Height="72" CornerRadius="16" Margin="0,0,0,20">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#e8842c" Offset="0" />
                            <GradientStop Color="#c05621" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Text="G" FontSize="36" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontFamily="Segoe UI" />
                </Border>

                <TextBlock Text="GRIMOIRE" FontSize="28" FontWeight="Bold"
                           Foreground="#e8842c" HorizontalAlignment="Center"
                           FontFamily="Segoe UI" />

                <TextBlock Text="Unified Product Data Toolkit" FontSize="13"
                           Foreground="#8b919e" HorizontalAlignment="Center"
                           Margin="0,6,0,30" FontFamily="Segoe UI" />

                <!-- Loading indicator -->
                <ProgressBar x:Name="LoadingBar" Width="240" Height="3"
                             IsIndeterminate="True" Foreground="#e8842c"
                             Background="#1e222e" BorderThickness="0" />

                <TextBlock x:Name="StatusText" Text="Starting backend..."
                           FontSize="12" Foreground="#555a66"
                           HorizontalAlignment="Center" Margin="0,14,0,0"
                           FontFamily="Segoe UI" />
            </StackPanel>
        </Grid>

        <!-- WebView2 browser -->
        <wv2:WebView2 x:Name="WebView"
                      Visibility="Collapsed"
                      DefaultBackgroundColor="#0c0e14" />
    </Grid>
</Window>
